# Settings contract (Varlock env-spec: https://varlock.dev/env-spec). Every setting the app reads.
# Never a real value here. Secrets and account identifiers live in Devolutions Hub (Platform vault,
# folder wisetelemetryreport\prod, one entry per variable named exactly after it). Non-secret values
# live in moline-platform apps/wisetelemetryreport/prod.env. For local development copy this file to
# .env (git-ignored) and fill it in.
#
# @defaultRequired=false @defaultSensitive=false
# ----------

# Port the HTTP server listens on (behind the platform proxy; no host port).
# @type=port
PORT=3000

# SQLite database (laser runs, tank levels, temperatures, last third-party call results).
# In the container: /data/data.db on the /data volume.
DATABASE_PATH=/data/data.db

# Folder holding the RADAN "Laser Report" ResultSheet*.xml files; only read, never written.
# In the container: the share, mounted read-only at /xml.
XML_MONITOR_DIRECTORY=/xml

# WISE Telemetry portal sign-in (nitrogen tank levels; signed in through Chromium/Puppeteer).
# @required @sensitive
WISE_TELEMETRY_USERNAME=
# @required @sensitive
WISE_TELEMETRY_PASSWORD=
# Customer (account) and device ids of the nitrogen tank sensor in the WISE portal.
# @required @sensitive
WISE_TELEMETRY_ACCOUNT_ID=
# @required @sensitive
WISE_TELEMETRY_DEVICE_ID=

# Visual Crossing weather API (average daily temperature).
# @required @sensitive
VISUAL_CROSSING_API_KEY=
# Location the temperatures are for (the plant), decimal degrees.
# @required @type=number
VISUAL_CROSSING_LATITUDE=
# @required @type=number
VISUAL_CROSSING_LONGITUDE=

# Protects POST /enumerateXML ("Authorization: Bearer <secret>" or "X-API-Key: <secret>").
# Unset: the route answers 503. The page itself needs no secret.
# @sensitive
API_SECRET=

# Time zone for "today" and the default date range.
TZ=America/Chicago
